[node name="GuideText" type="Label" parent="PaperAnswers" unique_id=1900042015]
layout_mode = 0
offset_left = 38.0
offset_top = 190.0
offset_right = 542.0
offset_bottom = 815.0
theme_override_colors/font_color = Color(0.24, 0.17, 0.12, 1)
theme_override_colors/font_shadow_color = Color(1, 0.95, 0.85, 0.25)
theme_override_constants/shadow_offset_x = 1
theme_override_constants/shadow_offset_y = 1
theme_override_font_sizes/font_size = 13
text = "1.  ∧  = AND / Conjunction
2.  ∨  = OR / Disjunction
3.  ¬  = NOT / Negation
4.  →  = Implication / Conditional
5.  ↔  = Biconditional / IF AND ONLY IF

LOGIC LAWS
6.  p ∨ p  = p          → Idempotent Law
7.  p ∧ T  = p          → Identity Law
8.  p ∨ F  = p          → Identity Law
9.  p ∧ ¬p = F          → Inverse Law
10. ¬(p ∧ q) = ¬p ∨ ¬q  → De Morgan's Law

SIMPLIFY
11. p ∨ p                  → p
12. p ∧ p                  → p
13. p ∨ F                  → p
14. p ∧ T                  → p
15. p ∨ ¬p                 → T / True
16. p ∧ ¬p                → F / False
17. (p ∨ q) ∧ (p ∨ q)     → p ∨ q
18. (p ∨ q) ∧ (¬p ∨ q)    → q
19. (p ∧ q) ∨ (p ∧ ¬q)    → p
20. ¬(p ∧ q) ∨ (p ∧ q)    → T / True

TIP:
Match the question number with the
corresponding answer above. Symbols
may be typed using words instead."
autowrap_mode = 2

