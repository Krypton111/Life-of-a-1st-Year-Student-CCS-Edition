; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Game Design"
run/main_scene="uid://d2pq7d7m5o1x"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="res://icon.svg"

[autoload]

GameManager="*uid://dbxd8bsuufrt4"
ChallengeManager="*uid://c785144e6hf5a"
FadeManager="*uid://cdesr476wtqbx"
DialogueManager="*uid://b4dnbeussb1d5"
QuestUIManager="*uid://tyhwv8w8lsud"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://GAME ASSETS_/Bookstore (Local Bookstore)/": "red",
"res://GAME ASSETS_/Cafe (Sus! Marya & Hosep Cafe)/": "purple",
"res://GAME ASSETS_/House+MC Room (inside only)/": "pink",
"res://GAME ASSETS_/School (University of Continuous Help System Prime)/": "yellow"
}

